# ローカル: docker compose up -d のあとこの URL を使う
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kabuto"
# Prisma の migrate 用。ローカルでは DATABASE_URL と同じでよい
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kabuto"

# --- Supabase（Vercel Production にも同様に設定）---
# パスワードは角括弧 [] で囲まない（[YOUR-PASSWORD] を実パスワードに置き換えたうえで [] ごと削除）
# 例: postgresql://postgres.xxxxx:ここに生パスワード@aws-....pooler....:6543/postgres?pgbouncer=true
# DATABASE_URL → Transaction pooler（例: 6543）+ 必要なら ?pgbouncer=true
# DIRECT_URL   → Session / Direct（例: 5432）。Connect 画面の表記に合わせる

# 本番の正規 URL（Auth のリダイレクト・メール内リンク用。Vercel では Production ドメインを推奨）
# NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Supabase（Project Settings → API / Connect から。キーは publishable または anon）
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# レガシー anon キーだけの場合はこちらでも可（どちらか一方）
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Connect ダイアログが DEFAULT という名前のとき用（任意）
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=""

# --- Supabase Auth（ダッシュボードで Email 等を有効化し、以下を設定）---
# 1) Authentication → URL: Site URL = 本番 origin（例 https://xxx.vercel.app）
# 2) Redirect URLs に https://xxx.vercel.app/auth/callback を追加
# 3) Vercel の NEXT_PUBLIC_SUPABASE_* が Supabase プロジェクトと一致しているか確認

# デモログイン /demo（Cookie のみ）。未設定時は本番では無効・開発では有効。
# 本番でデモを出す場合のみ true（非推奨）
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"

# デモログイン成功時のウォレット下限（pt）。未設定時は開発のみ 1000、本番は 0。
# 付与を止めるときは DEMO_WALLET_MIN_BALANCE_PT=0
# DEMO_WALLET_MIN_BALANCE_PT="1000"

# 期間限定ウォレットボーナス（ログイン後 1 回 / ユーザー）。WALLET_PROMO_PT だけで有効（本番含む）。
# slug 省略時は ltd-1000pt-202604。開発で未設定なら 1000pt。止めるときは WALLET_PROMO_PT=0
# WALLET_PROMO_PT="1000"
# WALLET_PROMO_SLUG="ltd-1000pt-202604"

# アバター画像アップロード（Supabase Storage）。バケット名 `avatars` を public または認証ユーザー向けに作成
# 未作成の場合はプロフィール設定で「画像 URL」のみ利用可能

# エージェント知識ファイル（任意）。バケット名 `agent-knowledge`。サーバーアップロード用に SUPABASE_SERVICE_ROLE_KEY も必要
# エージェント作成フォームのファイルは未設定時メタのみ保存されます

# ウェブ検索ツール（任意）。エージェントに「ウェブ検索」機能を有効にしたときに利用
# BRAVE_SEARCH_API_KEY=""

# ゲストチャットの IP ハッシュ用ソルト（本番では必須。未設定だと起動時に throw）
# 生成例: openssl rand -base64 32
# GUEST_IP_HASH_SALT=""

# MCP 資格情報の暗号化キー（本番では必須。未設定だと保存時に throw）
# AES-256-GCM で 32 バイト必要。base64 / hex / 任意文字列(SHA-256 で畳み込む)を許容
# 生成例: openssl rand -base64 32
# MCP_CREDENTIAL_KEY=""

# クリエイターへの還元率（0〜1）。残りはプラットフォーム手数料として台帳に記録
CREATOR_REVENUE_SHARE="0.65"

# --- /api/chat（Vercel AI SDK 直叩きプロバイダー）---
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# Gemini（どちらか一方。GEMINI_API_KEY は GOOGLE_GENERATIVE_AI_API_KEY のエイリアス）
# GOOGLE_GENERATIVE_AI_API_KEY=""
# GEMINI_API_KEY=""

# --- オプション: Supabase Vector RPC（KABUTO_VECTOR_RPC_ENABLED=true のとき）---
# SUPABASE_URL は NEXT_PUBLIC と同じプロジェクト URL でも可
# SUPABASE_SERVICE_ROLE_KEY=""
# KABUTO_VECTOR_RPC_ENABLED="false"
# KABUTO_VECTOR_MATCH_RPC="match_knowledge_chunks"
