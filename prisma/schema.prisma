// kabuto — Supabase Postgres 互換スキーマ（ローカルは Docker Postgres でも可）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProfileRole {
  user
  creator
  admin
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  /// Supabase Auth の user id（auth.users.id）と 1:1 で紐付け
  authUserId String? @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stripeCustomerId     String?              @unique

  profile              Profile?
  wallet               Wallet?
  creatorWallet        CreatorWallet?
  agentsCreated        Agent[]              @relation("CreatorAgents")
  reviews              Review[]
  usageLedgers         UsageLedger[]
  walletTransactions   WalletTransaction[]
  pointPurchases       PointPurchase[]
  chatSessions         ChatSession[]
  walletPromoClaims    WalletPromoClaim[]
  agentFavorites       AgentFavorite[]
  mcpConnections       UserMcpConnection[]
  pushSubscriptions    PushSubscription[]
}

/// 期間限定ウォレットキャンペーンの受け取り記録（同一 slug はユーザーにつき 1 回）
model WalletPromoClaim {
  id        String   @id @default(cuid())
  userId    String
  slug      String
  pointsPt  Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

/// ユーザーごとのロール（DB テーブル名は `profiles`）
model Profile {
  id        String      @id @default(cuid())
  userId    String      @unique
  role      ProfileRole @default(creator)
  /// クリエイター紹介など（エージェント一覧・プロフィールで利用想定）
  bio         String? @db.Text
  websiteUrl  String? @map("website_url")
  xUrl        String? @map("x_url")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// ゲスト（未ログイン）チャットの IP ベース日次枠（UTC 日付）
model GuestChatUsage {
  id        String   @id @default(cuid())
  ipHash    String
  dayUtc    String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([ipHash, dayUtc])
  @@index([ipHash])
}

/// 利用者のプリペイド残高（pt）
model Wallet {
  id        String @id @default(cuid())
  userId    String @unique
  balancePt Int    @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// クリエイター報酬の未払い残高（pt）
model CreatorWallet {
  id        String @id @default(cuid())
  userId    String @unique
  balancePt Int    @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agent {
  id          String  @id @default(cuid())
  slug        String  @unique
  creatorId   String
  title       String
  description String  @db.Text
  /// 表示用（絵文字1つなど）
  iconEmoji   String  @default("🤖")
  /// カスタム画像 URL（設定時は iconEmoji より優先して表示）
  iconUrl     String?
  /// 役割: システムプロンプト
  systemPrompt String @db.Text
  /// 追加のエージェント指示（任意）。未設定なら systemPrompt のみを使用
  instructions  String? @db.Text
  /// tools にマージする追加のツール設定 JSON
  toolConfig    Json?
  /// Supabase Vector 側のナレッジベース ID（任意）
  knowledgeBaseId String? @db.Uuid
  /// ベース価格（pt）。将来の固定課金や下限に利用可能（現行チャット課金はトークン従量が主）
  basePrice     Int?

  pricePerUsePt Int @default(10)
  usageCount    Int @default(0)

  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  reviewCount Int     @default(0)

  firstThreeFree Boolean @default(false)
  isPublished    Boolean @default(false)
  /// タグ（例: 高コスパ, 初回3回無料）
  tags           String[]

  /// 機能: Function Calling / 外部API 設定の配列 JSON
  tools Json @default("[]")

  defaultLlm String @default("gpt-4o")

  /// クリエイターが宣言した外部サービス連携キーの一覧（例: ["github", "notion"]）
  mcpServices String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator              User                   @relation("CreatorAgents", fields: [creatorId], references: [id], onDelete: Cascade)
  knowledgeDocuments   KnowledgeDocument[]
  conversationStarters ConversationStarter[]
  reviews              Review[]
  usageLedgers         UsageLedger[]
  walletTransactions   WalletTransaction[]
  chatSessions         ChatSession[]
  agentFavorites       AgentFavorite[]
}

/// 知識: アップロード文書のメタ（実ファイルは Storage 側を想定）
model KnowledgeDocument {
  id         String @id @default(cuid())
  agentId    String
  title      String
  mimeType   String
  storageKey String
  createdAt  DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

/// 会話スターター（最大4件はアプリ層で検証）
model ConversationStarter {
  id       String @id @default(cuid())
  agentId  String
  position Int
  text     String @db.Text

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, position])
  @@index([agentId])
}

model Review {
  id        String   @id @default(cuid())
  agentId   String
  userId    String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, userId])
  @@index([agentId])
}

/// 利用確定の台帳。idempotencyKey で二重課金を防止
model UsageLedger {
  id               String @id @default(cuid())
  userId           String
  agentId          String
  pointsCharged    Int
  creatorEarningsPt Int
  platformFeePt    Int
  idempotencyKey   String @unique
  createdAt        DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
}

/// LLM モデルごとのトークン単価（1k トークンあたりの消費 pt）
model ModelConfig {
  id         String   @id @default(cuid())
  modelId    String   @unique
  label      String?
  inputRate  Float
  outputRate Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Stripe でのポイント購入履歴
model PointPurchase {
  id              String   @id @default(cuid())
  userId          String
  amountPt        Int
  amountYen       Int
  stripeSessionId String   @unique
  /// "pending" | "completed" | "failed"
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// チャット会話セッション（ユーザーごと・エージェントごと）
model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, agentId])
  @@index([agentId])
}

/// チャットメッセージ
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  /// "user" | "assistant"
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// ユーザーのMCP接続情報（API キーや OAuth トークン）
model UserMcpConnection {
  id         String   @id @default(cuid())
  userId     String
  serverKey  String
  label      String

  /// "token" (user-pasted API key) | "oauth" (authorized via OAuth 2.0)
  authType   String   @default("token")

  // --- token 方式（既存 / 貼り付け API キー） ---
  /// AES-256-GCM 暗号化済み。oauth 方式では null。
  credential String?  @db.Text

  // --- oauth 方式（新規） ---
  /// 暗号化済み access_token
  accessToken  String?   @db.Text
  /// 暗号化済み refresh_token（発行されなかった場合は null）
  refreshToken String?   @db.Text
  /// access_token の失効時刻
  expiresAt    DateTime?
  /// 付与されたスコープ（スペース区切り）
  scopes       String?
  /// 認可したアカウントの表示用メールアドレス
  accountEmail String?
  /// 認可したアカウントの不変 ID（例: Google id_token の sub）
  accountId    String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serverKey])
  @@index([userId])
}

/// Web Push 通知サブスクリプション
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// お気に入りエージェント
model AgentFavorite {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([userId])
}

/// チャット実行ごとのトークン従量課金トランザクション
model WalletTransaction {
  id             String   @id @default(cuid())
  userId         String
  agentId        String?
  amountPt       Int
  tokenUsage     Json
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
}
